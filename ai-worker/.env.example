# ORP AI worker — konfigurasi runtime (semua opsional, ada default aman).

# Perangkat inferensi — selalu CPU pada deployment ini.
ORP_AI_DEVICE=cpu

# Checkpoint TorchXRayVision (lihat `orp-ai models` untuk daftar lengkap).
ORP_AI_MODEL=densenet121-res224-all

# Probabilitas minimum agar sebuah temuan dimasukkan ke laporan.
ORP_AI_THRESHOLD=0.15

# Jumlah temuan teratas yang dilaporkan.
ORP_AI_TOP_K=5

# Batas ukuran file upload HTTP (MB).
ORP_AI_MAX_UPLOAD_MB=25

# Override lokasi cache bobot torch.hub (default: ~/.cache/torch/hub).
# ORP_AI_CACHE_DIR=/mnt/DiskD/Workspace/Backups/ai-weights

# Path bobot model TB hasil fine-tune Colab (default: weights/tb_densenet121.pt).
# Kosongkan (default) untuk memakai weights/tb_densenet121.pt di folder proyek.
# ORP_AI_TB_WEIGHTS=/absolute/path/tb_densenet121.pt