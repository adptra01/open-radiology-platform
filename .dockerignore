# ORP RIS — Docker build context (root).
# Konteks dipakai 3 image: ris (butuh ris/ + platform/),
# adapter (butuh adapter/), ai-worker (butuh ai-worker/).
# Data besar, secrets, dan artifacts dev selalu dikecualikan.
.git/
.opencode/
.agents/
data/
docs/
backups/
sample-data/
logs/
link-opencode.txt
docker-compose.yml
docker-compose.prod.yml
.env.example
.env.prod.example
.gitignore
ai-worker/weights/*.pt
ai-worker/weights/*.bin
ris/vendor/
ris/node_modules/
ris/public/build
ris/public/hot
ris/.ddev/
ris/.env
ris/.env.*
!ris/.env.example
ris/storage/logs/
ris/storage/app/
ris/storage/framework/cache/
ris/storage/framework/sessions/
ris/storage/framework/views/
ris/bootstrap/cache/
