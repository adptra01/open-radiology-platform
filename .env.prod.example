# ORP RIS — Environment variables PRODUKSI
# Salin ke .env.prod, isi SEMUA nilai (jangan gunakan default!), lalu:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ============================================================
# Laravel (RIS)
# ============================================================
APP_KEY=base64:GANTI_DENGAN_32_BYTE_BASE64_DARI_php_artisan_key:generate
APP_URL=https://ris.rumahsakit.go.id
ORP_RIS_URL=https://ris.rumahsakit.go.id

# ============================================================
# Database (PostgreSQL)
# ============================================================
ORP_DB_PASSWORD=GANTI_PASSWORD_POSTGRES_KUAT_32_KARAKTER

# ============================================================
# Orthanc (PACS) — HTTP Basic Auth
# Password HANYA boleh: A-Z a-z 0-9 . _ ~ -
# Harus SAMA di Orthanc, OHIF proxy, dan RIS config.
# ============================================================
ORP_ORTHANC_USERNAME=orp
ORP_ORTHANC_PASSWORD=GANTI_PASSWORD_ORTHANC_KUAT_32_KARAKTER

# ============================================================
# OHIF Viewer (browser)
# URL publik viewer — di produksi gunakan domain + TLS, bukan localhost.
# ============================================================
ORP_OHIF_URL=https://viewer.rumahsakit.go.id

# ============================================================
# AI Worker
# ============================================================
ORP_AI_DEVICE=cpu
ORP_AI_MODEL=densenet121-res224-all
ORP_AI_THRESHOLD=0.15
ORP_AI_TOP_K=5
ORP_AI_MAX_UPLOAD_MB=25
# ORP_AI_TB_WEIGHTS=/weights/tb_densenet121.pt

# ============================================================
# Adapter (DICOM MWL/MPPS/STORE)
# ============================================================
ORP_AE_TITLE=ORPRIS
ORP_MWL_PORT=4243
ORP_MPPS_PORT=4244
ORP_STORE_PORT=4245
ORP_RIS_API_URL=https://ris.rumahsakit.go.id/api
ORP_RIS_API_KEY=GANTI_API_KEY_ADAPTER_32_KARAKTER_HEX

# ============================================================
# Catatan keamanan:
# - APP_KEY: generate dengan `php artisan key:generate --show` (output base64:...)
# - ORP_DB_PASSWORD: minimal 32 char, unik, simpan di password manager
# - ORP_ORTHANC_PASSWORD: karakter aman saja (alphanum + . _ ~ -)
# - ORP_RIS_API_KEY: 32 byte hex (64 char) — generate: `openssl rand -hex 32`
# - SEMUA file .env.prod HARUS di-ignore git (sudah di .gitignore)
# - Jangan pernah commit secret ke repo!
# ============================================================