# Docker Compose vendor stack (DCM4CHE/platform) — environment variables.
# Salin ke .env dan sesuaikan, lalu jalankan:
#   docker compose up -d

# PostgreSQL (vendor stack, tidak dipakai oleh ris/ yang ada di ddev;
# untuk produksi image ris akan terhubung ke service ini)
ORP_DB_PASSWORD=orp-secret-prod

# Orthanc (PACS) — kredensial HTTP (AuthenticationEnabled: true)
# Password hanya boleh berisi: A-Z a-z 0-9 . _ ~ -
ORP_ORTHANC_USERNAME=orp
ORP_ORTHANC_PASSWORD=orp-orthanc-prod

# AI Worker
ORP_AI_DEVICE=cpu
ORP_AI_MODEL=densenet121-res224-all
ORP_AI_THRESHOLD=0.15
ORP_AI_TOP_K=5
ORP_AI_MAX_UPLOAD_MB=25
# ORP_AI_TB_WEIGHTS=/weights/tb_densenet121.pt

# Adapter (DICOM MWL/MPPS/STORE SCP)
ORP_AE_TITLE=ORPRIS
ORP_MWL_PORT=4243
ORP_MPPS_PORT=4244
ORP_STORE_PORT=4245
ORP_RIS_API_URL=http://ris:80/api
ORP_RIS_API_KEY=change-me-in-production
